# Variáveis de Ambiente da Aplicação UrbanFlow
# No Vercel, configure esta variável em Settings > Environment Variables

# URL base da API FastAPI de Backend (deve terminar com /api)
# Local: http://localhost:8000/api
# Produção (Render, Railway, Fly.io, etc.): https://sua-api.onrender.com/api
VITE_API_URL=http://localhost:8000/api
